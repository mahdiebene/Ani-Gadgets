# Same-origin API; Vite proxies this to the local backend during development.
VITE_API_URL=/api

# For a separate production API, set this at build time after HTTPS/DNS cutover.
# Change it to your chosen API hostname, including /api, then rebuild/redeploy.
# VITE_API_URL=https://api.anigadgetsbd.app/api
# Never put database or SSH credentials in VITE_* variables (they are public).
