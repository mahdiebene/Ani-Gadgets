# Local PostgreSQL. API uses a read-only role; ingestion uses a writer role.
# On the VPS Docker secrets supply PGPASSWORD_FILE instead of a password here.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=anigadgets
PGUSER=anigadgets_reader
PGPASSWORD=replace_locally_never_commit
# Alternatively use DATABASE_URL in an ignored local .env.

# Server Configuration
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Set to 1 only behind a single trusted reverse proxy.
TRUST_PROXY=0

# Scraper Configuration
SCRAPE_DELAY_MS=3000
INGEST_MAX_REQUESTS=100
INGEST_MAX_KEYWORDS=25
INGEST_MAX_PAGES=2
INGEST_MAX_PRODUCTS=1000
INGEST_MIN_PRODUCTS=100
